(module
  (memory (export "memory") 1)

  ;; Static JSON string fragments at 0..249
  (data (i32.const 0) "{\"code\":\"stray_cr\",\"line\":")
  (data (i32.const 26) "{\"code\":\"quote_junk\",\"line\":")
  (data (i32.const 54) "{\"code\":\"unterminated_quote\",\"line\":")
  (data (i32.const 90) "{\"code\":\"short_row\",\"line\":")
  (data (i32.const 117) "{\"code\":\"long_row\",\"line\":")
  (data (i32.const 143) ",\"row\":null}")
  (data (i32.const 155) ",\"row\":")
  (data (i32.const 162) ",\"fields\":")
  (data (i32.const 172) ",\"extra\":[")
  (data (i32.const 182) "{\"columns\":null,\"rows\":[")
  (data (i32.const 206) "{\"columns\":")
  (data (i32.const 217) "],\"rows\":[")
  (data (i32.const 227) "[],\"rows\":[")
  (data (i32.const 238) "],\"errors\":[")

  (global $field_starts_base (mut i32) (i32.const 0))
  (global $err_base (mut i32) (i32.const 0))
  (global $err_limit (mut i32) (i32.const 0))

  (func (export "init_layout") (param $fs_base i32) (param $e_base i32) (param $e_limit i32)
    (global.set $field_starts_base (local.get $fs_base))
    (global.set $err_base (local.get $e_base))
    (global.set $err_limit (local.get $e_limit))
  )

  (func $ensure_out (param $need i32) (result i32)
    (local $cur_bytes i32)
    (local $pages_needed i32)
    (local.set $cur_bytes (i32.shl (memory.size) (i32.const 16)))
    (if (i32.le_u (local.get $need) (local.get $cur_bytes))
      (then (return (i32.const 1)))
    )
    (local.set $pages_needed
      (i32.shr_u
        (i32.add (i32.sub (local.get $need) (local.get $cur_bytes)) (i32.const 65535))
        (i32.const 16)
      )
    )
    (if (i32.lt_s (memory.grow (local.get $pages_needed)) (i32.const 0))
      (then (return (i32.const 0)))
    )
    (i32.const 1)
  )

  (func $write_uint (param $dst i32) (param $val i32) (result i32)
    (local $d0 i32) (local $q i32) (local $l i32) (local $r i32) (local $t i32)
    (if (i32.eqz (local.get $val))
      (then
        (i32.store8 (local.get $dst) (i32.const 0x30))
        (return (i32.add (local.get $dst) (i32.const 1)))
      )
    )
    (local.set $d0 (local.get $dst))
    (loop $dig
      (local.set $q (i32.div_u (local.get $val) (i32.const 10)))
      (i32.store8
        (local.get $dst)
        (i32.add (i32.const 0x30) (i32.sub (local.get $val) (i32.mul (local.get $q) (i32.const 10))))
      )
      (local.set $dst (i32.add (local.get $dst) (i32.const 1)))
      (local.set $val (local.get $q))
      (br_if $dig (i32.gt_u (local.get $val) (i32.const 0)))
    )
    (local.set $l (local.get $d0))
    (local.set $r (i32.sub (local.get $dst) (i32.const 1)))
    (block $rev_done
      (loop $rev
        (br_if $rev_done (i32.ge_u (local.get $l) (local.get $r)))
        (local.set $t (i32.load8_u (local.get $l)))
        (i32.store8 (local.get $l) (i32.load8_u (local.get $r)))
        (i32.store8 (local.get $r) (local.get $t))
        (local.set $l (i32.add (local.get $l) (i32.const 1)))
        (local.set $r (i32.sub (local.get $r) (i32.const 1)))
        (br $rev)
      )
    )
    (local.get $dst)
  )

  (func $emit_simple (param $eop i32) (param $code_off i32) (param $code_len i32) (param $line i32) (param $row i32) (result i32)
    (if (i32.gt_u (i32.add (local.get $eop) (i32.const 80)) (global.get $err_limit))
      (then (return (i32.const -2)))
    )
    (if (i32.gt_u (local.get $eop) (global.get $err_base))
      (then
        (i32.store8 (local.get $eop) (i32.const 0x2c))
        (local.set $eop (i32.add (local.get $eop) (i32.const 1)))
      )
    )
    (memory.copy (local.get $eop) (local.get $code_off) (local.get $code_len))
    (local.set $eop (i32.add (local.get $eop) (local.get $code_len)))
    (local.set $eop (call $write_uint (local.get $eop) (local.get $line)))
    (if (i32.lt_s (local.get $row) (i32.const 0))
      (then
        (memory.copy (local.get $eop) (i32.const 143) (i32.const 12))
        (return (i32.add (local.get $eop) (i32.const 12)))
      )
    )
    (memory.copy (local.get $eop) (i32.const 155) (i32.const 7))
    (local.set $eop (i32.add (local.get $eop) (i32.const 7)))
    (local.set $eop (call $write_uint (local.get $eop) (local.get $row)))
    (i32.store8 (local.get $eop) (i32.const 0x7d))
    (i32.add (local.get $eop) (i32.const 1))
  )

  (func $emit_short (param $eop i32) (param $line i32) (param $row i32) (param $flen i32) (result i32)
    (if (i32.gt_u (i32.add (local.get $eop) (i32.const 96)) (global.get $err_limit))
      (then (return (i32.const -2)))
    )
    (if (i32.gt_u (local.get $eop) (global.get $err_base))
      (then
        (i32.store8 (local.get $eop) (i32.const 0x2c))
        (local.set $eop (i32.add (local.get $eop) (i32.const 1)))
      )
    )
    (memory.copy (local.get $eop) (i32.const 90) (i32.const 27))
    (local.set $eop (i32.add (local.get $eop) (i32.const 27)))
    (local.set $eop (call $write_uint (local.get $eop) (local.get $line)))
    (memory.copy (local.get $eop) (i32.const 155) (i32.const 7))
    (local.set $eop (i32.add (local.get $eop) (i32.const 7)))
    (local.set $eop (call $write_uint (local.get $eop) (local.get $row)))
    (memory.copy (local.get $eop) (i32.const 162) (i32.const 10))
    (local.set $eop (i32.add (local.get $eop) (i32.const 10)))
    (local.set $eop (call $write_uint (local.get $eop) (local.get $flen)))
    (i32.store8 (local.get $eop) (i32.const 0x7d))
    (i32.add (local.get $eop) (i32.const 1))
  )

  (func $emit_long (param $eop i32) (param $line i32) (param $row i32) (param $start_off i32) (param $end_off i32) (result i32)
    (local $slice_len i32)
    (local.set $slice_len (i32.sub (local.get $end_off) (local.get $start_off)))
    (if (i32.gt_u (i32.add (local.get $eop) (i32.add (local.get $slice_len) (i32.const 96))) (global.get $err_limit))
      (then (return (i32.const -2)))
    )
    (if (i32.gt_u (local.get $eop) (global.get $err_base))
      (then
        (i32.store8 (local.get $eop) (i32.const 0x2c))
        (local.set $eop (i32.add (local.get $eop) (i32.const 1)))
      )
    )
    (memory.copy (local.get $eop) (i32.const 117) (i32.const 26))
    (local.set $eop (i32.add (local.get $eop) (i32.const 26)))
    (local.set $eop (call $write_uint (local.get $eop) (local.get $line)))
    (memory.copy (local.get $eop) (i32.const 155) (i32.const 7))
    (local.set $eop (i32.add (local.get $eop) (i32.const 7)))
    (local.set $eop (call $write_uint (local.get $eop) (local.get $row)))
    (memory.copy (local.get $eop) (i32.const 172) (i32.const 10))
    (local.set $eop (i32.add (local.get $eop) (i32.const 10)))
    (memory.copy (local.get $eop) (local.get $start_off) (local.get $slice_len))
    (local.set $eop (i32.add (local.get $eop) (local.get $slice_len)))
    (i32.store8 (local.get $eop) (i32.const 0x5d))
    (i32.store8 (i32.add (local.get $eop) (i32.const 1)) (i32.const 0x7d))
    (i32.add (local.get $eop) (i32.const 2))
  )

  (func (export "process_case") (param $src_start i32) (param $src_end i32) (param $header i32) (param $op i32) (result i32)
    (local $p i32)
    (local $eop i32)
    (local $line i32)
    (local $width i32)
    (local $columns_done i32)
    (local $row_count i32)
    (local $record_line i32)
    (local $record_row i32)
    (local $row_start_op i32)
    (local $flen i32)
    (local $first_quoted i32)
    (local $is_quoted i32)
    (local $field_data_start i32)
    (local $open i32)
    (local $open_line i32)
    (local $closed i32)
    (local $junk_mode i32)
    (local $junk_added i32)
    (local $b i32)
    (local $b2 i32)
    (local $mask i32)
    (local $tz i32)
    (local $v v128)
    (local $splat_bs v128)
    (local $splat_comma v128)
    (local $empty_row_op i32)
    (local $k i32)
    (local $cut_start i32)
    (local $err_len i32)

    (local.set $p (local.get $src_start))
    (local.set $eop (global.get $err_base))
    (local.set $line (i32.const 1))
    (local.set $width (i32.const -1))
    (local.set $columns_done (i32.eqz (local.get $header)))
    (local.set $row_count (i32.const 0))

    (local.set $splat_bs (i8x16.splat (i32.const 0x5c)))
    (local.set $splat_comma (i8x16.splat (i32.const 0x2c)))

    ;; Ensure enough space in out buffer for the case body
    (if (i32.eqz (call $ensure_out (i32.add (local.get $op) (i32.add (i32.mul (i32.sub (local.get $src_end) (local.get $p)) (i32.const 2)) (i32.const 65536)))))
      (then (return (i32.const -2)))
    )

    ;; Skip UTF-8 BOM (EF BB BF) or \ufeff / \uFEFF
    (if (i32.and
          (i32.le_u (i32.add (local.get $p) (i32.const 3)) (local.get $src_end))
          (i32.and
            (i32.eq (i32.load8_u (local.get $p)) (i32.const 0xef))
            (i32.eq (i32.load16_u (i32.add (local.get $p) (i32.const 1))) (i32.const 0xbfbb))
          )
        )
      (then (local.set $p (i32.add (local.get $p) (i32.const 3))))
      (else
        (if (i32.and
              (i32.le_u (i32.add (local.get $p) (i32.const 6)) (local.get $src_end))
              (i32.and
                (i32.eq (i32.load16_u (local.get $p)) (i32.const 0x755c)) ;; \u
                (i32.and
                  (i32.eq (i32.or (i32.load8_u (i32.add (local.get $p) (i32.const 2))) (i32.const 0x20)) (i32.const 0x66))
                  (i32.and
                    (i32.eq (i32.or (i32.load8_u (i32.add (local.get $p) (i32.const 3))) (i32.const 0x20)) (i32.const 0x65))
                    (i32.and
                      (i32.eq (i32.or (i32.load8_u (i32.add (local.get $p) (i32.const 4))) (i32.const 0x20)) (i32.const 0x66))
                      (i32.eq (i32.or (i32.load8_u (i32.add (local.get $p) (i32.const 5))) (i32.const 0x20)) (i32.const 0x66))
                    )
                  )
                )
              )
            )
          (then (local.set $p (i32.add (local.get $p) (i32.const 6))))
        )
      )
    )

    ;; Emit initial JSON prefix
    (if (local.get $header)
      (then
        (memory.copy (local.get $op) (i32.const 206) (i32.const 11))
        (local.set $op (i32.add (local.get $op) (i32.const 11)))
      )
      (else
        (memory.copy (local.get $op) (i32.const 182) (i32.const 24))
        (local.set $op (i32.add (local.get $op) (i32.const 24)))
      )
    )

    ;; Outer record loop
    (block $outer_done
      (loop $outer
        ;; Skip blank lines (\n or \r\n)
        (block $skip_done
          (loop $skip
            (br_if $skip_done (i32.ge_u (local.get $p) (local.get $src_end)))
            (br_if $skip_done (i32.ne (i32.load8_u (local.get $p)) (i32.const 0x5c)))
            (if (i32.ge_u (i32.add (local.get $p) (i32.const 1)) (local.get $src_end))
              (then (return (i32.const -1)))
            )
            (local.set $b2 (i32.load8_u (i32.add (local.get $p) (i32.const 1))))
            (if (i32.eq (local.get $b2) (i32.const 0x6e))
              (then
                (local.set $p (i32.add (local.get $p) (i32.const 2)))
                (local.set $line (i32.add (local.get $line) (i32.const 1)))
                (br $skip)
              )
            )
            (if (i32.and
                  (i32.eq (local.get $b2) (i32.const 0x72))
                  (i32.and
                    (i32.le_u (i32.add (local.get $p) (i32.const 4)) (local.get $src_end))
                    (i32.eq (i32.load16_u (i32.add (local.get $p) (i32.const 2))) (i32.const 0x6e5c))
                  )
                )
              (then
                (local.set $p (i32.add (local.get $p) (i32.const 4)))
                (local.set $line (i32.add (local.get $line) (i32.const 1)))
                (br $skip)
              )
            )
            (br $skip_done)
          )
        )
        (br_if $outer_done (i32.ge_u (local.get $p) (local.get $src_end)))

        (local.set $record_line (local.get $line))
        (local.set $record_row
          (if (result i32) (local.get $columns_done)
            (then (local.get $row_count))
            (else (i32.const -1))
          )
        )
        (local.set $row_start_op (local.get $op))

        (if (i32.and (local.get $columns_done) (i32.gt_s (local.get $row_count) (i32.const 0)))
          (then
            (i32.store8 (local.get $op) (i32.const 0x2c))
            (local.set $op (i32.add (local.get $op) (i32.const 1)))
          )
        )
        (i32.store8 (local.get $op) (i32.const 0x5b))
        (local.set $op (i32.add (local.get $op) (i32.const 1)))

        (local.set $flen (i32.const 0))
        (local.set $first_quoted (i32.const 0))

        ;; Field loop
        (block $field_done
          (loop $field_loop
            (if (i32.ge_u (local.get $flen) (i32.const 16384))
              (then (return (i32.const -2)))
            )
            (if (i32.gt_u (local.get $flen) (i32.const 0))
              (then
                (i32.store8 (local.get $op) (i32.const 0x2c))
                (local.set $op (i32.add (local.get $op) (i32.const 1)))
              )
            )
            (local.set $is_quoted
              (i32.and
                (i32.le_u (i32.add (local.get $p) (i32.const 2)) (local.get $src_end))
                (i32.eq (i32.load16_u (local.get $p)) (i32.const 0x225c))
              )
            )
            (if (i32.eqz (local.get $flen))
              (then (local.set $first_quoted (local.get $is_quoted)))
            )
            (i32.store
              (i32.add (global.get $field_starts_base) (i32.shl (local.get $flen) (i32.const 2)))
              (local.get $op)
            )
            (local.set $flen (i32.add (local.get $flen) (i32.const 1)))
            (i32.store8 (local.get $op) (i32.const 0x22))
            (local.set $op (i32.add (local.get $op) (i32.const 1)))
            (local.set $field_data_start (local.get $op))

            (local.set $junk_mode (i32.const 0))
            (local.set $junk_added (i32.const 0))

            (block $enter_unquoted
              (if (local.get $is_quoted)
                (then
                  (local.set $open (local.get $p))
                  (local.set $open_line (local.get $line))
                  (local.set $p (i32.add (local.get $p) (i32.const 2)))
                  (local.set $closed (i32.const 0))

                  ;; Quoted SIMD loop
                  (block $q_simd_done
                    (loop $q_simd
                      (br_if $q_simd_done (i32.gt_u (i32.add (local.get $p) (i32.const 16)) (local.get $src_end)))
                      (local.set $v (v128.load (local.get $p)))
                      (v128.store (local.get $op) (local.get $v))
                      (local.set $mask (i8x16.bitmask (i8x16.eq (local.get $v) (local.get $splat_bs))))
                      (if (i32.eqz (local.get $mask))
                        (then
                          (local.set $p (i32.add (local.get $p) (i32.const 16)))
                          (local.set $op (i32.add (local.get $op) (i32.const 16)))
                          (br $q_simd)
                        )
                      )
                      (local.set $tz (i32.ctz (local.get $mask)))
                      (local.set $p (i32.add (local.get $p) (local.get $tz)))
                      (local.set $op (i32.add (local.get $op) (local.get $tz)))

                      (if (i32.ge_u (i32.add (local.get $p) (i32.const 1)) (local.get $src_end))
                        (then (return (i32.const -1)))
                      )
                      (local.set $b2 (i32.load8_u (i32.add (local.get $p) (i32.const 1))))
                      (if (i32.eq (local.get $b2) (i32.const 0x22))
                        (then
                          (if (i32.and
                                (i32.le_u (i32.add (local.get $p) (i32.const 4)) (local.get $src_end))
                                (i32.eq (i32.load16_u (i32.add (local.get $p) (i32.const 2))) (i32.const 0x225c))
                              )
                            (then
                              (i32.store16 (local.get $op) (i32.const 0x225c))
                              (local.set $op (i32.add (local.get $op) (i32.const 2)))
                              (local.set $p (i32.add (local.get $p) (i32.const 4)))
                              (br $q_simd)
                            )
                          )
                          (local.set $p (i32.add (local.get $p) (i32.const 2)))
                          (local.set $closed (i32.const 1))
                          (br $q_simd_done)
                        )
                      )
                      (if (i32.eq (local.get $b2) (i32.const 0x72))
                        (then
                          (i32.store16 (local.get $op) (i32.const 0x6e5c))
                          (local.set $op (i32.add (local.get $op) (i32.const 2)))
                          (local.set $line (i32.add (local.get $line) (i32.const 1)))
                          (if (i32.and
                                (i32.le_u (i32.add (local.get $p) (i32.const 4)) (local.get $src_end))
                                (i32.eq (i32.load16_u (i32.add (local.get $p) (i32.const 2))) (i32.const 0x6e5c))
                              )
                            (then (local.set $p (i32.add (local.get $p) (i32.const 4))))
                            (else (local.set $p (i32.add (local.get $p) (i32.const 2))))
                          )
                          (br $q_simd)
                        )
                      )
                      (if (i32.eq (local.get $b2) (i32.const 0x6e))
                        (then
                          (i32.store16 (local.get $op) (i32.const 0x6e5c))
                          (local.set $op (i32.add (local.get $op) (i32.const 2)))
                          (local.set $p (i32.add (local.get $p) (i32.const 2)))
                          (local.set $line (i32.add (local.get $line) (i32.const 1)))
                          (br $q_simd)
                        )
                      )
                      (if (i32.or (i32.eq (local.get $b2) (i32.const 0x75)) (i32.eq (local.get $b2) (i32.const 0x2f)))
                        (then (return (i32.const -1)))
                      )
                      (i32.store8 (local.get $op) (i32.const 0x5c))
                      (i32.store8 (i32.add (local.get $op) (i32.const 1)) (local.get $b2))
                      (local.set $op (i32.add (local.get $op) (i32.const 2)))
                      (local.set $p (i32.add (local.get $p) (i32.const 2)))
                      (br $q_simd)
                    )
                  )

                  ;; Quoted scalar tail
                  (if (i32.eqz (local.get $closed))
                    (then
                      (block $q_tail_done
                        (loop $q_tail
                          (br_if $q_tail_done (i32.ge_u (local.get $p) (local.get $src_end)))
                          (local.set $b (i32.load8_u (local.get $p)))
                          (if (i32.ne (local.get $b) (i32.const 0x5c))
                            (then
                              (i32.store8 (local.get $op) (local.get $b))
                              (local.set $op (i32.add (local.get $op) (i32.const 1)))
                              (local.set $p (i32.add (local.get $p) (i32.const 1)))
                              (br $q_tail)
                            )
                          )
                          (if (i32.ge_u (i32.add (local.get $p) (i32.const 1)) (local.get $src_end))
                            (then (return (i32.const -1)))
                          )
                          (local.set $b2 (i32.load8_u (i32.add (local.get $p) (i32.const 1))))
                          (if (i32.eq (local.get $b2) (i32.const 0x22))
                            (then
                              (if (i32.and
                                    (i32.le_u (i32.add (local.get $p) (i32.const 4)) (local.get $src_end))
                                    (i32.eq (i32.load16_u (i32.add (local.get $p) (i32.const 2))) (i32.const 0x225c))
                                  )
                                (then
                                  (i32.store16 (local.get $op) (i32.const 0x225c))
                                  (local.set $op (i32.add (local.get $op) (i32.const 2)))
                                  (local.set $p (i32.add (local.get $p) (i32.const 4)))
                                  (br $q_tail)
                                )
                              )
                              (local.set $p (i32.add (local.get $p) (i32.const 2)))
                              (local.set $closed (i32.const 1))
                              (br $q_tail_done)
                            )
                          )
                          (if (i32.eq (local.get $b2) (i32.const 0x72))
                            (then
                              (i32.store16 (local.get $op) (i32.const 0x6e5c))
                              (local.set $op (i32.add (local.get $op) (i32.const 2)))
                              (local.set $line (i32.add (local.get $line) (i32.const 1)))
                              (if (i32.and
                                    (i32.le_u (i32.add (local.get $p) (i32.const 4)) (local.get $src_end))
                                    (i32.eq (i32.load16_u (i32.add (local.get $p) (i32.const 2))) (i32.const 0x6e5c))
                                  )
                                (then (local.set $p (i32.add (local.get $p) (i32.const 4))))
                                (else (local.set $p (i32.add (local.get $p) (i32.const 2))))
                              )
                              (br $q_tail)
                            )
                          )
                          (if (i32.eq (local.get $b2) (i32.const 0x6e))
                            (then
                              (i32.store16 (local.get $op) (i32.const 0x6e5c))
                              (local.set $op (i32.add (local.get $op) (i32.const 2)))
                              (local.set $p (i32.add (local.get $p) (i32.const 2)))
                              (local.set $line (i32.add (local.get $line) (i32.const 1)))
                              (br $q_tail)
                            )
                          )
                          (if (i32.or (i32.eq (local.get $b2) (i32.const 0x75)) (i32.eq (local.get $b2) (i32.const 0x2f)))
                            (then (return (i32.const -1)))
                          )
                          (i32.store8 (local.get $op) (i32.const 0x5c))
                          (i32.store8 (i32.add (local.get $op) (i32.const 1)) (local.get $b2))
                          (local.set $op (i32.add (local.get $op) (i32.const 2)))
                          (local.set $p (i32.add (local.get $p) (i32.const 2)))
                          (br $q_tail)
                        )
                      )
                    )
                  )

                  ;; Check if closed
                  (if (i32.eqz (local.get $closed))
                    (then
                      (local.set $eop (call $emit_simple (local.get $eop) (i32.const 54) (i32.const 36) (local.get $record_line) (local.get $record_row)))
                      (if (i32.lt_s (local.get $eop) (i32.const 0)) (then (return (local.get $eop))))
                      (local.set $op (local.get $field_data_start))
                      (i32.store16 (local.get $op) (i32.const 0x225c))
                      (local.set $op (i32.add (local.get $op) (i32.const 2)))
                      (local.set $p (i32.add (local.get $open) (i32.const 2)))
                      (local.set $line (local.get $open_line))
                      (br $enter_unquoted)
                    )
                  )

                  ;; Closed quote: check delimiter right after
                  (if (i32.ge_u (local.get $p) (local.get $src_end))
                    (then
                      (i32.store8 (local.get $op) (i32.const 0x22))
                      (local.set $op (i32.add (local.get $op) (i32.const 1)))
                      (br $field_done)
                    )
                  )
                  (local.set $b (i32.load8_u (local.get $p)))
                  (if (i32.eq (local.get $b) (i32.const 0x2c))
                    (then
                      (i32.store8 (local.get $op) (i32.const 0x22))
                      (local.set $op (i32.add (local.get $op) (i32.const 1)))
                      (local.set $p (i32.add (local.get $p) (i32.const 1)))
                      (br $field_loop)
                    )
                  )
                  (if (i32.eq (local.get $b) (i32.const 0x5c))
                    (then
                      (if (i32.ge_u (i32.add (local.get $p) (i32.const 1)) (local.get $src_end))
                        (then (return (i32.const -1)))
                      )
                      (local.set $b2 (i32.load8_u (i32.add (local.get $p) (i32.const 1))))
                      (if (i32.eq (local.get $b2) (i32.const 0x6e))
                        (then
                          (i32.store8 (local.get $op) (i32.const 0x22))
                          (local.set $op (i32.add (local.get $op) (i32.const 1)))
                          (local.set $p (i32.add (local.get $p) (i32.const 2)))
                          (local.set $line (i32.add (local.get $line) (i32.const 1)))
                          (br $field_done)
                        )
                      )
                      (if (i32.and
                            (i32.eq (local.get $b2) (i32.const 0x72))
                            (i32.and
                              (i32.le_u (i32.add (local.get $p) (i32.const 4)) (local.get $src_end))
                              (i32.eq (i32.load16_u (i32.add (local.get $p) (i32.const 2))) (i32.const 0x6e5c))
                            )
                          )
                        (then
                          (i32.store8 (local.get $op) (i32.const 0x22))
                          (local.set $op (i32.add (local.get $op) (i32.const 1)))
                          (local.set $p (i32.add (local.get $p) (i32.const 4)))
                          (local.set $line (i32.add (local.get $line) (i32.const 1)))
                          (br $field_done)
                        )
                      )
                    )
                  )
                  ;; Post-quote junk tail
                  (local.set $junk_mode (i32.const 1))
                )
              )
            )

            ;; Unquoted SIMD loop (also handles post-quote junk tail when $junk_mode == 1)
            (block $u_simd_done
              (loop $u_simd
                (br_if $u_simd_done (i32.gt_u (i32.add (local.get $p) (i32.const 16)) (local.get $src_end)))
                (local.set $v (v128.load (local.get $p)))
                (v128.store (local.get $op) (local.get $v))
                (local.set $mask
                  (i8x16.bitmask
                    (v128.or
                      (i8x16.eq (local.get $v) (local.get $splat_comma))
                      (i8x16.eq (local.get $v) (local.get $splat_bs))
                    )
                  )
                )
                (if (i32.eqz (local.get $mask))
                  (then
                    (local.set $p (i32.add (local.get $p) (i32.const 16)))
                    (local.set $op (i32.add (local.get $op) (i32.const 16)))
                    (local.set $junk_added (i32.const 1))
                    (br $u_simd)
                  )
                )
                (local.set $tz (i32.ctz (local.get $mask)))
                (local.set $p (i32.add (local.get $p) (local.get $tz)))
                (local.set $op (i32.add (local.get $op) (local.get $tz)))
                (if (i32.gt_u (local.get $tz) (i32.const 0))
                  (then (local.set $junk_added (i32.const 1)))
                )

                (local.set $b (i32.load8_u (local.get $p)))
                (if (i32.eq (local.get $b) (i32.const 0x2c))
                  (then
                    (if (i32.and (local.get $junk_mode) (local.get $junk_added))
                      (then
                        (local.set $eop (call $emit_simple (local.get $eop) (i32.const 26) (i32.const 28) (local.get $record_line) (local.get $record_row)))
                        (if (i32.lt_s (local.get $eop) (i32.const 0)) (then (return (local.get $eop))))
                      )
                    )
                    (if (i32.and
                          (i32.eqz (local.get $junk_mode))
                          (i32.and
                            (i32.lt_u (local.get $flen) (i32.const 16384))
                            (i32.and
                              (i32.le_u (i32.add (local.get $p) (i32.const 3)) (local.get $src_end))
                              (i32.ne (i32.load16_u (i32.add (local.get $p) (i32.const 1))) (i32.const 0x225c))
                            )
                          )
                        )
                      (then
                        (i32.store (local.get $op) (i32.const 0x00222c22))
                        (i32.store
                          (i32.add (global.get $field_starts_base) (i32.shl (local.get $flen) (i32.const 2)))
                          (i32.add (local.get $op) (i32.const 2))
                        )
                        (local.set $flen (i32.add (local.get $flen) (i32.const 1)))
                        (local.set $op (i32.add (local.get $op) (i32.const 3)))
                        (local.set $p (i32.add (local.get $p) (i32.const 1)))
                        (br $u_simd)
                      )
                    )
                    (i32.store8 (local.get $op) (i32.const 0x22))
                    (local.set $op (i32.add (local.get $op) (i32.const 1)))
                    (local.set $p (i32.add (local.get $p) (i32.const 1)))
                    (br $field_loop)
                  )
                )

                ;; $b == 0x5c
                (if (i32.ge_u (i32.add (local.get $p) (i32.const 1)) (local.get $src_end))
                  (then (return (i32.const -1)))
                )
                (local.set $b2 (i32.load8_u (i32.add (local.get $p) (i32.const 1))))
                (if (i32.eq (local.get $b2) (i32.const 0x6e))
                  (then
                    (if (i32.and (local.get $junk_mode) (local.get $junk_added))
                      (then
                        (local.set $eop (call $emit_simple (local.get $eop) (i32.const 26) (i32.const 28) (local.get $record_line) (local.get $record_row)))
                        (if (i32.lt_s (local.get $eop) (i32.const 0)) (then (return (local.get $eop))))
                      )
                    )
                    (i32.store8 (local.get $op) (i32.const 0x22))
                    (local.set $op (i32.add (local.get $op) (i32.const 1)))
                    (local.set $p (i32.add (local.get $p) (i32.const 2)))
                    (local.set $line (i32.add (local.get $line) (i32.const 1)))
                    (br $field_done)
                  )
                )
                (if (i32.eq (local.get $b2) (i32.const 0x72))
                  (then
                    (if (i32.and
                          (i32.le_u (i32.add (local.get $p) (i32.const 4)) (local.get $src_end))
                          (i32.eq (i32.load16_u (i32.add (local.get $p) (i32.const 2))) (i32.const 0x6e5c))
                        )
                      (then
                        (if (i32.and (local.get $junk_mode) (local.get $junk_added))
                          (then
                            (local.set $eop (call $emit_simple (local.get $eop) (i32.const 26) (i32.const 28) (local.get $record_line) (local.get $record_row)))
                            (if (i32.lt_s (local.get $eop) (i32.const 0)) (then (return (local.get $eop))))
                          )
                        )
                        (i32.store8 (local.get $op) (i32.const 0x22))
                        (local.set $op (i32.add (local.get $op) (i32.const 1)))
                        (local.set $p (i32.add (local.get $p) (i32.const 4)))
                        (local.set $line (i32.add (local.get $line) (i32.const 1)))
                        (br $field_done)
                      )
                    )
                    (local.set $eop (call $emit_simple (local.get $eop) (i32.const 0) (i32.const 26) (local.get $record_line) (local.get $record_row)))
                    (if (i32.lt_s (local.get $eop) (i32.const 0)) (then (return (local.get $eop))))
                    (local.set $p (i32.add (local.get $p) (i32.const 2)))
                    (br $u_simd)
                  )
                )
                (if (i32.or (i32.eq (local.get $b2) (i32.const 0x75)) (i32.eq (local.get $b2) (i32.const 0x2f)))
                  (then (return (i32.const -1)))
                )
                (i32.store8 (local.get $op) (i32.const 0x5c))
                (i32.store8 (i32.add (local.get $op) (i32.const 1)) (local.get $b2))
                (local.set $op (i32.add (local.get $op) (i32.const 2)))
                (local.set $p (i32.add (local.get $p) (i32.const 2)))
                (local.set $junk_added (i32.const 1))
                (br $u_simd)
              )
            )

            ;; Unquoted scalar tail
            (block $u_tail_done
              (loop $u_tail
                (br_if $u_tail_done (i32.ge_u (local.get $p) (local.get $src_end)))
                (local.set $b (i32.load8_u (local.get $p)))
                (if (i32.eq (local.get $b) (i32.const 0x2c))
                  (then
                    (if (i32.and (local.get $junk_mode) (local.get $junk_added))
                      (then
                        (local.set $eop (call $emit_simple (local.get $eop) (i32.const 26) (i32.const 28) (local.get $record_line) (local.get $record_row)))
                        (if (i32.lt_s (local.get $eop) (i32.const 0)) (then (return (local.get $eop))))
                      )
                    )
                    (if (i32.and
                          (i32.eqz (local.get $junk_mode))
                          (i32.and
                            (i32.lt_u (local.get $flen) (i32.const 16384))
                            (i32.and
                              (i32.le_u (i32.add (local.get $p) (i32.const 3)) (local.get $src_end))
                              (i32.ne (i32.load16_u (i32.add (local.get $p) (i32.const 1))) (i32.const 0x225c))
                            )
                          )
                        )
                      (then
                        (i32.store (local.get $op) (i32.const 0x00222c22))
                        (i32.store
                          (i32.add (global.get $field_starts_base) (i32.shl (local.get $flen) (i32.const 2)))
                          (i32.add (local.get $op) (i32.const 2))
                        )
                        (local.set $flen (i32.add (local.get $flen) (i32.const 1)))
                        (local.set $op (i32.add (local.get $op) (i32.const 3)))
                        (local.set $p (i32.add (local.get $p) (i32.const 1)))
                        (br $u_tail)
                      )
                    )
                    (i32.store8 (local.get $op) (i32.const 0x22))
                    (local.set $op (i32.add (local.get $op) (i32.const 1)))
                    (local.set $p (i32.add (local.get $p) (i32.const 1)))
                    (br $field_loop)
                  )
                )
                (if (i32.eq (local.get $b) (i32.const 0x5c))
                  (then
                    (if (i32.ge_u (i32.add (local.get $p) (i32.const 1)) (local.get $src_end))
                      (then (return (i32.const -1)))
                    )
                    (local.set $b2 (i32.load8_u (i32.add (local.get $p) (i32.const 1))))
                    (if (i32.eq (local.get $b2) (i32.const 0x6e))
                      (then
                        (if (i32.and (local.get $junk_mode) (local.get $junk_added))
                          (then
                            (local.set $eop (call $emit_simple (local.get $eop) (i32.const 26) (i32.const 28) (local.get $record_line) (local.get $record_row)))
                            (if (i32.lt_s (local.get $eop) (i32.const 0)) (then (return (local.get $eop))))
                          )
                        )
                        (i32.store8 (local.get $op) (i32.const 0x22))
                        (local.set $op (i32.add (local.get $op) (i32.const 1)))
                        (local.set $p (i32.add (local.get $p) (i32.const 2)))
                        (local.set $line (i32.add (local.get $line) (i32.const 1)))
                        (br $field_done)
                      )
                    )
                    (if (i32.eq (local.get $b2) (i32.const 0x72))
                      (then
                        (if (i32.and
                              (i32.le_u (i32.add (local.get $p) (i32.const 4)) (local.get $src_end))
                              (i32.eq (i32.load16_u (i32.add (local.get $p) (i32.const 2))) (i32.const 0x6e5c))
                            )
                          (then
                            (if (i32.and (local.get $junk_mode) (local.get $junk_added))
                              (then
                                (local.set $eop (call $emit_simple (local.get $eop) (i32.const 26) (i32.const 28) (local.get $record_line) (local.get $record_row)))
                                (if (i32.lt_s (local.get $eop) (i32.const 0)) (then (return (local.get $eop))))
                              )
                            )
                            (i32.store8 (local.get $op) (i32.const 0x22))
                            (local.set $op (i32.add (local.get $op) (i32.const 1)))
                            (local.set $p (i32.add (local.get $p) (i32.const 4)))
                            (local.set $line (i32.add (local.get $line) (i32.const 1)))
                            (br $field_done)
                          )
                        )
                        (local.set $eop (call $emit_simple (local.get $eop) (i32.const 0) (i32.const 26) (local.get $record_line) (local.get $record_row)))
                        (if (i32.lt_s (local.get $eop) (i32.const 0)) (then (return (local.get $eop))))
                        (local.set $p (i32.add (local.get $p) (i32.const 2)))
                        (br $u_tail)
                      )
                    )
                    (if (i32.or (i32.eq (local.get $b2) (i32.const 0x75)) (i32.eq (local.get $b2) (i32.const 0x2f)))
                      (then (return (i32.const -1)))
                    )
                    (i32.store8 (local.get $op) (i32.const 0x5c))
                    (i32.store8 (i32.add (local.get $op) (i32.const 1)) (local.get $b2))
                    (local.set $op (i32.add (local.get $op) (i32.const 2)))
                    (local.set $p (i32.add (local.get $p) (i32.const 2)))
                    (local.set $junk_added (i32.const 1))
                    (br $u_tail)
                  )
                )
                (i32.store8 (local.get $op) (local.get $b))
                (local.set $op (i32.add (local.get $op) (i32.const 1)))
                (local.set $p (i32.add (local.get $p) (i32.const 1)))
                (local.set $junk_added (i32.const 1))
                (br $u_tail)
              )
            )
            ;; EOF inside unquoted / tail
            (if (i32.and (local.get $junk_mode) (local.get $junk_added))
              (then
                (local.set $eop (call $emit_simple (local.get $eop) (i32.const 26) (i32.const 28) (local.get $record_line) (local.get $record_row)))
                (if (i32.lt_s (local.get $eop) (i32.const 0)) (then (return (local.get $eop))))
              )
            )
            (i32.store8 (local.get $op) (i32.const 0x22))
            (local.set $op (i32.add (local.get $op) (i32.const 1)))
          )
        )

        ;; Check empty stray-CR-only unquoted line
        (local.set $empty_row_op
          (i32.add
            (local.get $row_start_op)
            (if (result i32) (i32.and (local.get $columns_done) (i32.gt_s (local.get $row_count) (i32.const 0)))
              (then (i32.const 4))
              (else (i32.const 3))
            )
          )
        )
        (if (i32.and
              (i32.eq (local.get $flen) (i32.const 1))
              (i32.and (i32.eqz (local.get $first_quoted)) (i32.eq (local.get $op) (local.get $empty_row_op)))
            )
          (then
            (local.set $op (local.get $row_start_op))
            (br $outer)
          )
        )

        (if (i32.lt_s (local.get $width) (i32.const 0))
          (then (local.set $width (local.get $flen)))
        )

        (if (i32.eqz (local.get $columns_done))
          (then
            (memory.copy (local.get $op) (i32.const 217) (i32.const 10))
            (local.set $op (i32.add (local.get $op) (i32.const 10)))
            (local.set $columns_done (i32.const 1))
            (br $outer)
          )
        )

        (if (i32.lt_s (local.get $flen) (local.get $width))
          (then
            (local.set $eop (call $emit_short (local.get $eop) (local.get $record_line) (local.get $record_row) (local.get $flen)))
            (if (i32.lt_s (local.get $eop) (i32.const 0)) (then (return (local.get $eop))))
            (if (i32.eqz (call $ensure_out (i32.add (local.get $op) (i32.add (i32.mul (i32.sub (local.get $width) (local.get $flen)) (i32.const 3)) (i32.const 65536)))))
              (then (return (i32.const -2)))
            )
            (local.set $k (local.get $flen))
            (loop $pad
              (i32.store8 (local.get $op) (i32.const 0x2c))
              (i32.store16 (i32.add (local.get $op) (i32.const 1)) (i32.const 0x2222))
              (local.set $op (i32.add (local.get $op) (i32.const 3)))
              (local.set $k (i32.add (local.get $k) (i32.const 1)))
              (br_if $pad (i32.lt_s (local.get $k) (local.get $width)))
            )
            (i32.store8 (local.get $op) (i32.const 0x5d))
            (local.set $op (i32.add (local.get $op) (i32.const 1)))
          )
          (else
            (if (i32.gt_s (local.get $flen) (local.get $width))
              (then
                (local.set $cut_start
                  (i32.load (i32.add (global.get $field_starts_base) (i32.shl (local.get $width) (i32.const 2))))
                )
                (local.set $eop (call $emit_long (local.get $eop) (local.get $record_line) (local.get $record_row) (local.get $cut_start) (local.get $op)))
                (if (i32.lt_s (local.get $eop) (i32.const 0)) (then (return (local.get $eop))))
                (local.set $op (i32.sub (local.get $cut_start) (i32.const 1)))
                (i32.store8 (local.get $op) (i32.const 0x5d))
                (local.set $op (i32.add (local.get $op) (i32.const 1)))
              )
              (else
                (i32.store8 (local.get $op) (i32.const 0x5d))
                (local.set $op (i32.add (local.get $op) (i32.const 1)))
              )
            )
          )
        )
        (local.set $row_count (i32.add (local.get $row_count) (i32.const 1)))
        (br $outer)
      )
    )

    ;; Finalize case JSON
    (if (i32.eqz (local.get $columns_done))
      (then
        (memory.copy (local.get $op) (i32.const 227) (i32.const 11))
        (local.set $op (i32.add (local.get $op) (i32.const 11)))
      )
    )
    (memory.copy (local.get $op) (i32.const 238) (i32.const 12))
    (local.set $op (i32.add (local.get $op) (i32.const 12)))

    (local.set $err_len (i32.sub (local.get $eop) (global.get $err_base)))
    (if (i32.gt_u (local.get $err_len) (i32.const 0))
      (then
        (if (i32.eqz (call $ensure_out (i32.add (local.get $op) (i32.add (local.get $err_len) (i32.const 64)))))
          (then (return (i32.const -2)))
        )
        (memory.copy (local.get $op) (global.get $err_base) (local.get $err_len))
        (local.set $op (i32.add (local.get $op) (local.get $err_len)))
      )
    )
    (i32.store8 (local.get $op) (i32.const 0x5d))
    (i32.store8 (i32.add (local.get $op) (i32.const 1)) (i32.const 0x7d))
    (i32.add (local.get $op) (i32.const 2))
  )
)
